{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rsj99-dev/MethArCT/schemas/metharct-input-inspection.schema.json",
  "title": "MethArCT input inspection result",
  "description": "Result of metharct inspect / client.inspect_input. sequence_type_confidence is a rule level, never a calibrated probability.",
  "type": "object",
  "required": [
    "schema_version",
    "path",
    "filename",
    "file_exists",
    "file_size_bytes",
    "format_detected",
    "sequence_type",
    "sequence_type_confidence",
    "expected_type",
    "sequence_count",
    "total_residues",
    "length",
    "invalid_sequence_count",
    "duplicate_id_count",
    "valid",
    "compatible_modules",
    "incompatible_modules",
    "warnings",
    "errors",
    "sha256",
    "modified_time"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "path": { "type": "string" },
    "filename": { "type": "string" },
    "file_exists": { "type": "boolean" },
    "file_size_bytes": { "type": "integer", "minimum": 0 },
    "format_detected": { "type": "string" },
    "sequence_type": {
      "type": "string",
      "enum": ["protein", "nucleotide", "ambiguous", "unknown"]
    },
    "sequence_type_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "none"]
    },
    "expected_type": {
      "type": "string",
      "enum": ["auto", "protein", "nucleotide"]
    },
    "sequence_count": { "type": "integer", "minimum": 0 },
    "total_residues": { "type": "integer", "minimum": 0 },
    "length": {
      "type": "object",
      "required": ["min", "median", "max"],
      "properties": {
        "min": { "type": ["integer", "null"], "minimum": 0 },
        "median": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "invalid_sequence_count": { "type": "integer", "minimum": 0 },
    "duplicate_id_count": { "type": "integer", "minimum": 0 },
    "valid": { "type": "boolean" },
    "compatible_modules": { "type": "array", "items": { "type": "string" } },
    "incompatible_modules": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "sha256": { "type": ["string", "null"] },
    "modified_time": { "type": ["string", "null"] },
    "max_file_size_mb": { "type": "integer", "minimum": 0 }
  }
}
