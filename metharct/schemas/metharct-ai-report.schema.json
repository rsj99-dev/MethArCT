{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rsj99-dev/MethArCT/schemas/metharct-ai-report.schema.json",
  "title": "MethArCT unified AI report",
  "description": "Schema version 1.0 of metharct_ai_report.json. Missing values are represented as null; no placeholder numbers are permitted.",
  "type": "object",
  "required": [
    "schema_version",
    "software",
    "run",
    "input",
    "requested_modules",
    "modules",
    "warnings",
    "errors",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "software": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      }
    },
    "run": {
      "type": "object",
      "required": ["job_id", "created_at", "started_at", "finished_at", "status", "duration_seconds"],
      "properties": {
        "job_id": { "type": "string" },
        "created_at": { "type": "string" },
        "started_at": { "type": ["string", "null"] },
        "finished_at": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "validating",
            "running",
            "succeeded",
            "partially_succeeded",
            "failed",
            "cancelled"
          ]
        },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "input": {
      "type": "object",
      "required": ["filename", "sha256", "format", "type", "sequence_count", "total_residues"],
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": ["string", "null"] },
        "format": { "type": "string" },
        "type": { "type": ["string", "null"] },
        "sequence_count": { "type": ["integer", "null"], "minimum": 0 },
        "total_residues": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "requested_modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/moduleResult" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/definitions/errorEntry" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/artifact" }
    },
    "provenance": {
      "type": "object",
      "required": ["parameters", "database_versions", "model_versions", "environment"],
      "properties": {
        "parameters": { "type": "object" },
        "database_versions": { "type": "object" },
        "model_versions": { "type": "object" },
        "environment": { "type": "object" }
      }
    }
  },
  "definitions": {
    "errorEntry": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "moduleResult": {
      "type": "object",
      "required": [
        "module",
        "status",
        "result_type",
        "summary",
        "values",
        "units",
        "evidence",
        "limitations",
        "source_artifacts",
        "model",
        "error",
        "runtime_seconds"
      ],
      "properties": {
        "module": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "partial",
            "failed",
            "skipped",
            "not_available",
            "not_applicable"
          ]
        },
        "result_type": { "type": "string" },
        "summary": { "type": ["string", "null"] },
        "values": { "type": "object" },
        "units": { "type": "object" },
        "evidence": { "type": "array" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact_id"],
            "properties": {
              "artifact_id": { "type": "string" },
              "kind": { "type": ["string", "null"] }
            }
          }
        },
        "model": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] }
          }
        },
        "error": { "type": ["string", "null"] },
        "runtime_seconds": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "path",
        "media_type",
        "size_bytes",
        "sha256",
        "row_count",
        "description",
        "module",
        "filename"
      ],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^a[0-9]{3,}$" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\./).*$" },
        "media_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "row_count": { "type": ["integer", "null"], "minimum": 0 },
        "description": { "type": "string" },
        "module": { "type": ["string", "null"] },
        "filename": { "type": "string" }
      }
    }
  }
}
