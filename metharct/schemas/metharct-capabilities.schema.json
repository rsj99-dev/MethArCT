{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rsj99-dev/MethArCT/schemas/metharct-capabilities.schema.json",
  "title": "MethArCT capability description",
  "description": "Dynamic capability manifest returned by metharct capabilities. Every status value is derived from a real dependency, database or model-file probe.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "software",
    "environment",
    "modules",
    "input_types",
    "supports",
    "report_schema_version",
    "error_codes"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "generated_at": { "type": "string" },
    "software": {
      "type": "object",
      "required": ["name", "version", "ai_api_version", "commit"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "ai_api_version": { "type": "string" },
        "commit": { "type": ["string", "null"] }
      }
    },
    "environment": {
      "type": "object",
      "required": ["python_version", "python_executable", "platform"],
      "properties": {
        "python_version": { "type": "string" },
        "python_executable": { "type": "string" },
        "platform": { "type": "string" },
        "implementation": { "type": ["string", "null"] }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "display_name",
          "description",
          "input_types",
          "required_dependencies",
          "optional_dependencies",
          "output_artifacts",
          "options",
          "model",
          "limitations",
          "enabled",
          "status",
          "missing",
          "reasons"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z_]+$" },
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "input_types": { "type": "array", "items": { "type": "string" } },
          "required_dependencies": { "type": "array", "items": { "type": "string" } },
          "optional_dependencies": { "type": "array", "items": { "type": "string" } },
          "output_artifacts": { "type": "array", "items": { "type": "string" } },
          "options": { "type": "array" },
          "model": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": ["string", "null"] },
              "version": { "type": ["string", "null"] }
            }
          },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "enabled": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["available", "unavailable", "misconfigured", "not_required"]
          },
          "checks": { "type": "array" },
          "missing": { "type": "array" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "input_types": { "type": "array", "items": { "type": "string" } },
    "supports": {
      "type": "object",
      "required": ["async_jobs", "job_cancel", "batch_input", "mcp", "json_report"],
      "properties": {
        "async_jobs": { "type": "boolean" },
        "job_cancel": { "type": "boolean" },
        "batch_input": { "type": "boolean" },
        "mcp": { "type": "boolean" },
        "json_report": { "type": "boolean" }
      }
    },
    "report_schema_version": { "type": "string" },
    "error_codes": { "type": "array", "items": { "type": "string" } }
  }
}
