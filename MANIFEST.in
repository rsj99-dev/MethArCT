# Include documentation
include README.md
include LICENSE
include LICENSE-MIT

# Include configuration files
include metharct_config.yaml
include requirements.txt
include environment.yml

# Include package source
recursive-include metharct *.py
recursive-include metharct *.yaml
recursive-include metharct *.yml
recursive-include metharct/core/susha/models *.pkl
recursive-include metharct/core/mlhuainanzi/models *.pkl
recursive-include metharct/core/ph_predictor/models *.joblib
recursive-include metharct/core/ph_predictor/hmm *.joblib

# Include reference databases (installed via data_files in setup.py)
recursive-include data/databases *

# Exclude cache and compiled files
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo

# Exclude generated output and build artifacts
prune results
prune build
prune dist
prune tests/__pycache__
exclude metharct_analysis.py
exclude metharct.log
